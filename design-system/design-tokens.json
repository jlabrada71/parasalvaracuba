      "focusBorderWidth": "3px"
    }
  },
  "guidelines": {
    "noHarshBorders": "Never use 1px solid borders. Define boundaries through color shifts or whitespace.",
    "glassMorphism": "Use backdrop-blur-md (12px) for floating navigation and overlays with semi-transparent surfaces.",
    "surfaceHierarchy": "Layer UI like stacked sheets: surface → surface-container-low → surface-container-lowest.",
    "asymmetricMargins": "Use asymmetric margins in hero sections (e.g., 8.5rem left, 5.5rem right) for editorial rhythm.",
    "colorTransitions": "Use coral (#FF7F50) for success states, voting interactions, and urgent actions.",
    "touchTargets": "Ensure all interactive elements are 44px+ for mobile accessibility.",
    "textColor": "Use on-surface (#181c1c) instead of pure black for a premium, soft feel.",
    "roundness": "Use lg/xl (1rem+) for large containers; sm/md for small components.",
    "whitespace": "Generous spacing creates 'breathing room' for ideas.",
    "photography": "Use high-key imagery with 40% primary color overlay for text legibility."
  }
